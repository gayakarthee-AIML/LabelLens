# Base URL of the LabelLens FastAPI backend.
# Local dev:      VITE_API_BASE_URL=http://localhost:8000/api/v1
# Phone testing via a single ngrok tunnel (see vite.config.ts's dev proxy):
#                 VITE_API_BASE_URL=/api/v1
#                 (relative path — the dev server proxies /api/* straight to
#                 the backend on the same machine, so only the frontend needs
#                 a tunnel; the free ngrok plan only allows one at a time)
# Colab/ngrok (backend tunneled separately):
#                 VITE_API_BASE_URL=https://<your-ngrok-id>.ngrok-free.app/api/v1
# Production:     VITE_API_BASE_URL=https://api.labellens.example.gov.in/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
