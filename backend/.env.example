# --- App ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+psycopg2://labellens:labellens@localhost:5432/labellens

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO / S3-compatible) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=labellens-evidence
S3_REGION=us-east-1

# --- AI/CV ---
# Per the brief, OCR only runs English + Hindi.
PADDLEOCR_LANGS=en,hi
YOLO_WEIGHTS_PATH=./app/services/weights/label_regions.pt

# --- QR/barcode scanning scope ---
# Only these product categories require/scan a barcode or QR code.
ELECTRONIC_CATEGORIES=Electronics,Electronics Accessory,Electronic Appliance

# --- Font size checking (reference-card calibration) ---
# ISO/IEC 7810 ID-1 card size (debit/credit/Aadhaar-style card) by default.
REFERENCE_CARD_WIDTH_MM=85.60
REFERENCE_CARD_HEIGHT_MM=53.98

# --- Government rule feed adapter (no live API exists yet; left disabled) ---
GOV_RULE_FEED_ENABLED=false
GOV_RULE_FEED_URL=

# --- E-commerce listing compliance — multimodal AI extraction (optional) ---
# Leave ANTHROPIC_API_KEY blank to disable AI extraction entirely; the
# e-commerce flow still runs on deterministic JSON-LD/text/OCR extraction
# and the rule engine, it just won't fill in fields only findable via AI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ECOMMERCE_FETCH_TIMEOUT_SECONDS=15
ECOMMERCE_MAX_IMAGES=4
